{
  "name": "schema-in-the-mist",
  "version": "1.3.4",
  "description": "Open, versioned data schemas for Mist Engine games (City of Mist, :Otherscape, Legend in the Mist) to make digital tools interoperable.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "gen": "tsx tools/gen-schemas.ts",
    "validate": "tsx tools/validate-examples.ts",
    "validate:contract": "tsx tools/validate-contract.ts",
    "validate:packs": "tsx tools/validate-packs.ts",
    "validate:source-conversion": "tsx tools/validate-source-conversion.ts",
    "validate:version": "tsx tools/validate-version-compat.ts",
    "validate:package": "tsx tools/validate-package.ts",
    "release:prepare": "tsx tools/prepare-release.ts",
    "release-train:stage": "tsx tools/release-train-stage.ts",
    "release-train:assert": "tsx tools/release-train-assert.ts",
    "release-train:promote": "tsx tools/release-train-promote.ts",
    "release-train:validate": "tsx tools/validate-release-train.ts",
    "test:release-train-manifest": "tsx tools/test-release-train-manifest.ts",
    "validate:appearance-compat": "tsx tools/validate-appearance-compat.ts",
    "validate:handbook-packs": "tsx tools/validate-handbook-packs.ts",
    "test:handbook-contrast": "tsx tools/test-handbook-contrast.ts",
    "generate:otherscape-design": "tsx tools/build-otherscape-handbook-design.ts --write",
    "validate:otherscape-design": "tsx tools/validate-otherscape-design.ts && tsx tools/build-otherscape-handbook-design.ts --check",
    "check": "npm run typecheck && npm run build && npm run gen && npm run validate && npm run validate:contract && npm run validate:source-conversion && npm run validate:version && npm run validate:appearance-compat && npm run validate:otherscape-design && npm run test:handbook-contrast && npm run validate:handbook-packs && npm run validate:packs && npm run test:release-train-manifest && npm run release-train:validate",
    "toml:one": "tsx tools/toml2json.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RebelliousSmile/schema-in-the-mist.git"
  },
  "keywords": [
    "City of Mist",
    "Legend in the Mist",
    ":Otherscape",
    "Schema",
    "Interoperable"
  ],
  "author": "4rtamis",
  "license": "MIT AND CC-BY-4.0",
  "bugs": {
    "url": "https://github.com/RebelliousSmile/schema-in-the-mist/issues"
  },
  "homepage": "https://github.com/RebelliousSmile/schema-in-the-mist#readme",
  "type": "module",
  "files": [
    "dist",
    "schemas/v1",
    "schemas/appearance",
    "corpus/contract",
    "cross-tool-provider.json",
    "handbook",
    "README.md",
    "LICENSES"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/v1/*": "./schemas/v1/*",
    "./schemas/appearance/*": "./schemas/appearance/*",
    "./corpus/contract/*": "./corpus/contract/*",
    "./cross-tool-provider.json": "./cross-tool-provider.json",
    "./handbook/*": "./handbook/*",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/node": "^24.5.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "zod": "^4.6.2"
  }
}
