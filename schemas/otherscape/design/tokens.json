      "sm": { "$type": "dimension", "$value": "1rem" },
      "md": { "$type": "dimension", "$value": "1.5rem" },
      "lg": { "$type": "dimension", "$value": "2.25rem" }
    },
    "stroke": {
      "regular": { "$type": "dimension", "$value": "1.5px" },
      "bold": { "$type": "dimension", "$value": "2px" }
    }
  },
  "zIndex": {
    "base": { "$type": "number", "$value": 0 },
    "sticky": { "$type": "number", "$value": 10 },
    "dropdown": { "$type": "number", "$value": 20 },
    "overlay": { "$type": "number", "$value": 30 },
    "modal": { "$type": "number", "$value": 40 },
    "toast": { "$type": "number", "$value": 50 }
