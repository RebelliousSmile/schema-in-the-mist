  "themes": {
    "dark": {
      "color": {
        "theme": {
          "self": { "$value": "#E05A6E" },
          "mythos": { "$value": "#A98BD0" },
          "noise": { "$value": "#5D9BD4" }
        },
        "semantic": {
          "background": { "$value": "{color.neutral.900}" },
          "surface": { "$value": "{color.neutral.800}" },
          "text": { "$value": "{color.neutral.50}" },
          "text-muted": { "$value": "{color.neutral.200}" },
          "border": { "$value": "{color.neutral.700}" }
        }
      }
    }
  }
