      "primary": { "$type": "color", "$value": "#C8FF2E" },
      "cyan": { "$type": "color", "$value": "#20CFE3" },
      "signal": { "$type": "color", "$value": "#FF3C5C" },
      "violet": { "$type": "color", "$value": "#4E426F" }
    },
    "theme": {
      "self": { "$type": "color", "$value": "#B4233E" },
      "mythos": { "$type": "color", "$value": "#7B4FB0" },
      "noise": { "$type": "color", "$value": "#075F8B" }
    },
    "neutral": {
      "50": { "$type": "color", "$value": "#F6F7F4" },
      "100": { "$type": "color", "$value": "#E4E8E8" },
      "200": { "$type": "color", "$value": "#CBD3D5" },
      "300": { "$type": "color", "$value": "#AAB5BD" },
      "500": { "$type": "color", "$value": "#667182" },
      "700": { "$type": "color", "$value": "#242A46" },
      "800": { "$type": "color", "$value": "#0B0F2F" },
      "900": { "$type": "color", "$value": "#05071D" }
    },
    "semantic": {
      "background": { "$type": "color", "$value": "{color.neutral.50}" },
      "surface": { "$type": "color", "$value": "{color.neutral.100}" },
      "text": { "$type": "color", "$value": "{color.neutral.900}" },
      "text-muted": { "$type": "color", "$value": "{color.neutral.700}" },
