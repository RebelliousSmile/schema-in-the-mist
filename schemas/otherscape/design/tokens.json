  "size": {
    "container": {
      "reading": { "$type": "dimension", "$value": "42rem" },
      "page": { "$type": "dimension", "$value": "80rem" },
      "wide": { "$type": "dimension", "$value": "96rem" }
    }
  },
  "icon": {
