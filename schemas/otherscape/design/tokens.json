    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "none": { "$type": "shadow", "$value": { "color": "#05071D00", "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "0" } },
    "panel": { "$type": "shadow", "$value": { "color": "#05071D26", "offsetX": "0", "offsetY": "0.5rem", "blur": "1.5rem", "spread": "0" } }
  },
