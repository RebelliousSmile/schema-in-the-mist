      "display": { "$type": "fontFamily", "$value": "\"Averia Serif Libre\", serif" },
      "sans": { "$type": "fontFamily", "$value": "\"IM Fell English\", serif" },
      "mono": { "$type": "fontFamily", "$value": "ui-monospace, monospace" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "black": { "$type": "fontWeight", "$value": 900 }
    },
    "size": {
      "caption": { "$type": "dimension", "$value": "0.75rem" },
      "body": { "$type": "dimension", "$value": "1rem" },
      "lead": { "$type": "dimension", "$value": "clamp(1.125rem, 1.02rem + 0.45vw, 1.5rem)" },
      "title": { "$type": "dimension", "$value": "clamp(1.5rem, 1.18rem + 1.4vw, 2.5rem)" },
      "display": { "$type": "dimension", "$value": "clamp(2.75rem, 2rem + 4vw, 5.5rem)" }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 0.9 },
      "title": { "$type": "number", "$value": 1 },
      "body": { "$type": "number", "$value": 1.35 },
      "loose": { "$type": "number", "$value": 1.5 }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
